{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbita",
  "version": "0.0.12",
  "identifier": "com.orbita.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orbita",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "decorations": false,
        "skipTaskbar": false,
        "center": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
