{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbita.local/contracts/journal-health/v1/schemas/activity.json",
  "title": "activity snapshot",
  "type": "object",
  "required": [
    "id",
    "localDate",
    "source",
    "revision",
    "activity",
    "contentHash",
    "naturalKey",
    "createdAtUtc",
    "updatedAtUtc"
  ],
  "properties": {
    "id": { "$ref": "_common.json#/$defs/uuid" },
    "localDate": { "$ref": "_common.json#/$defs/localDate" },
    "source": { "$ref": "_common.json#/$defs/source" },
    "revision": { "type": "integer", "minimum": 1 },
    "externalId": {
      "type": ["string", "null"],
      "description": "Garmin activityId; required for source=garmin."
    },
    "activity": {
      "type": "object",
      "required": ["sport", "duration"],
      "properties": {
        "sport": { "type": "string" },
        "duration": { "type": "integer", "minimum": 0 },
        "metrics": {
          "type": "object",
          "properties": {
            "startTime": { "type": "integer" },
            "distance": { "type": "number" },
            "distance_km": { "type": "number" },
            "elevation_gain_m": { "type": "integer" },
            "avg_speed_kmh": { "type": "number" },
            "avg_power_w": { "type": "integer" },
            "normalized_power": { "type": "integer" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "contentHash": { "$ref": "_common.json#/$defs/contentHash" },
    "naturalKey": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "externalId": { "type": ["string", "null"] },
        "id": { "$ref": "_common.json#/$defs/uuid" },
        "source": { "$ref": "_common.json#/$defs/source" }
      },
      "additionalProperties": false
    },
    "createdAtUtc": { "$ref": "_common.json#/$defs/rfc3339Utc" },
    "updatedAtUtc": { "$ref": "_common.json#/$defs/rfc3339Utc" },
    "deletedAtUtc": {
      "oneOf": [{ "$ref": "_common.json#/$defs/rfc3339Utc" }, { "type": "null" }]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "source": { "const": "garmin" } }, "required": ["source"] },
      "then": {
        "required": ["externalId"],
        "properties": {
          "externalId": { "type": "string", "minLength": 1 },
          "naturalKey": { "required": ["externalId"] }
        }
      }
    },
    {
      "if": { "properties": { "source": { "const": "manual" } }, "required": ["source"] },
      "then": {
        "naturalKey": { "required": ["id"] }
      }
    }
  ]
}
