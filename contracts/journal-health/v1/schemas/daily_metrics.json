{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbita.local/contracts/journal-health/v1/schemas/daily_metrics.json",
  "title": "daily_metrics snapshot",
  "type": "object",
  "required": [
    "id",
    "localDate",
    "source",
    "revision",
    "data",
    "contentHash",
    "createdAtUtc",
    "updatedAtUtc",
    "naturalKey"
  ],
  "properties": {
    "id": { "$ref": "_common.json#/$defs/uuid" },
    "localDate": { "$ref": "_common.json#/$defs/localDate" },
    "source": { "$ref": "_common.json#/$defs/source" },
    "revision": { "type": "integer", "minimum": 1 },
    "fetchedAt": {
      "oneOf": [{ "type": "integer" }, { "type": "null" }],
      "description": "Unix epoch seconds when Garmin data was fetched; omitted for manual."
    },
    "data": {
      "type": "object",
      "properties": {
        "steps": { "type": "integer", "minimum": 0 },
        "hydrationMl": { "type": "integer", "minimum": 0 },
        "activeCalories": { "type": "integer", "minimum": 0 },
        "restingHeartRate": { "type": "integer", "minimum": 0 },
        "stressHigh": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "contentHash": { "$ref": "_common.json#/$defs/contentHash" },
    "naturalKey": {
      "type": "object",
      "required": ["localDate", "source"],
      "properties": {
        "localDate": { "$ref": "_common.json#/$defs/localDate" },
        "source": { "$ref": "_common.json#/$defs/source" }
      },
      "additionalProperties": false
    },
    "createdAtUtc": { "$ref": "_common.json#/$defs/rfc3339Utc" },
    "updatedAtUtc": { "$ref": "_common.json#/$defs/rfc3339Utc" },
    "deletedAtUtc": {
      "oneOf": [{ "$ref": "_common.json#/$defs/rfc3339Utc" }, { "type": "null" }]
    }
  },
  "additionalProperties": false
}
