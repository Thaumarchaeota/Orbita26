{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbita.local/contracts/journal-health/v1/schemas/body_measurement.json",
  "title": "body_measurement snapshot",
  "type": "object",
  "required": [
    "id",
    "localDate",
    "source",
    "revision",
    "payload",
    "contentHash",
    "naturalKey",
    "createdAtUtc",
    "updatedAtUtc"
  ],
  "properties": {
    "id": { "$ref": "_common.json#/$defs/uuid" },
    "localDate": { "$ref": "_common.json#/$defs/localDate" },
    "source": { "$ref": "_common.json#/$defs/source" },
    "revision": { "type": "integer", "minimum": 1 },
    "payload": {
      "type": "object",
      "required": ["weightKg"],
      "properties": {
        "weightKg": { "type": "number", "exclusiveMinimum": 0 },
        "source": { "$ref": "_common.json#/$defs/source" },
        "externalId": { "type": "string" }
      },
      "additionalProperties": true
    },
    "contentHash": { "$ref": "_common.json#/$defs/contentHash" },
    "naturalKey": {
      "type": "object",
      "required": ["localDate", "source", "contentHash"],
      "properties": {
        "localDate": { "$ref": "_common.json#/$defs/localDate" },
        "source": { "$ref": "_common.json#/$defs/source" },
        "contentHash": { "$ref": "_common.json#/$defs/contentHash" }
      },
      "additionalProperties": false
    },
    "createdAtUtc": { "$ref": "_common.json#/$defs/rfc3339Utc" },
    "updatedAtUtc": { "$ref": "_common.json#/$defs/rfc3339Utc" },
    "deletedAtUtc": {
      "oneOf": [{ "$ref": "_common.json#/$defs/rfc3339Utc" }, { "type": "null" }]
    }
  },
  "additionalProperties": false
}
