{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbita.local/contracts/journal-health/v1/schemas/metric_day_snapshot.json",
  "title": "metric_day_snapshot",
  "type": "object",
  "required": [
    "id",
    "localDate",
    "metricName",
    "source",
    "revision",
    "payload",
    "contentHash",
    "naturalKey",
    "createdAtUtc",
    "updatedAtUtc"
  ],
  "properties": {
    "id": { "$ref": "_common.json#/$defs/uuid" },
    "localDate": { "$ref": "_common.json#/$defs/localDate" },
    "metricName": {
      "type": "string",
      "enum": [
        "hr",
        "stress",
        "body_battery",
        "spo2",
        "respiration",
        "hrv",
        "steps",
        "steps_cumulative"
      ]
    },
    "source": { "$ref": "_common.json#/$defs/source" },
    "revision": { "type": "integer", "minimum": 1 },
    "payload": {
      "type": "object",
      "required": ["samples", "coverage"],
      "properties": {
        "samples": {
          "type": "array",
          "items": { "$ref": "_common.json#/$defs/metricSample" }
        },
        "coverage": {
          "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
        },
        "parserRev": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "contentHash": { "$ref": "_common.json#/$defs/contentHash" },
    "naturalKey": {
      "type": "object",
      "required": ["localDate", "metricName", "source", "coverage", "contentHash"],
      "properties": {
        "localDate": { "$ref": "_common.json#/$defs/localDate" },
        "metricName": { "type": "string" },
        "source": { "$ref": "_common.json#/$defs/source" },
        "coverage": {
          "oneOf": [{ "type": "number" }, { "type": "null" }]
        },
        "contentHash": { "$ref": "_common.json#/$defs/contentHash" }
      },
      "additionalProperties": false
    },
    "createdAtUtc": { "$ref": "_common.json#/$defs/rfc3339Utc" },
    "updatedAtUtc": { "$ref": "_common.json#/$defs/rfc3339Utc" },
    "deletedAtUtc": {
      "oneOf": [{ "$ref": "_common.json#/$defs/rfc3339Utc" }, { "type": "null" }]
    }
  },
  "additionalProperties": false
}
