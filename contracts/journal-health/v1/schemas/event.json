{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbita.local/contracts/journal-health/v1/schemas/event.json",
  "title": "event snapshot",
  "type": "object",
  "required": [
    "id",
    "localDate",
    "source",
    "revision",
    "payload",
    "naturalKey",
    "createdAtUtc",
    "updatedAtUtc"
  ],
  "properties": {
    "id": { "$ref": "_common.json#/$defs/uuid" },
    "localDate": { "$ref": "_common.json#/$defs/localDate" },
    "source": { "$ref": "_common.json#/$defs/source" },
    "revision": { "type": "integer", "minimum": 1 },
    "payload": {
      "type": "object",
      "properties": {
        "at": { "type": "integer", "description": "Unix epoch seconds." },
        "remark": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "naturalKey": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "_common.json#/$defs/uuid" }
      },
      "additionalProperties": false
    },
    "createdAtUtc": { "$ref": "_common.json#/$defs/rfc3339Utc" },
    "updatedAtUtc": { "$ref": "_common.json#/$defs/rfc3339Utc" },
    "deletedAtUtc": {
      "oneOf": [{ "$ref": "_common.json#/$defs/rfc3339Utc" }, { "type": "null" }]
    }
  },
  "additionalProperties": false
}
