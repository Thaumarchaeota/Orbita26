{
  "meta": {
    "title": "Orbita Object Schema Registry",
    "status": "proposed",
    "purpose": "Object 字段、子类型字段可用性、校验和 UI 读取规则的单一语义定义。它不是 SQLite DDL、迁移文件或当前实现事实。",
    "storageRule": "目标中，进入 Sync Core allowlist 的 Archive object、独立 data-root 与其 component/严格子 data 必须以各端 SQLite 为唯一事实存储；本文件随应用版本维护，并由程序加载为只读 registry。‘既有真源’仅描述尚未迁移的当前实现，不能作为 Core aggregate 或形成双真源。",
    "unknownFieldRule": "直接修改 SQLite 所写入的未知字段不自动报错；读取时须给出兼容性警告，已知类型的未知字段可能在后续保存中丢失。"
  },
  "sharedObjectFields": {
    "id": {
      "dataType": "uuid",
      "required": true,
      "description": "稳定且不编码 domain/type 的对象标识。"
    },
    "createdAt": {
      "dataType": "utcDateTime",
      "required": true,
      "managedBy": "system"
    },
    "updatedAt": {
      "dataType": "utcDateTime",
      "required": true,
      "managedBy": "system"
    },
    "deletedAt": {
      "dataType": "utcDateTime",
      "required": false,
      "managedBy": "system"
    }
  },
  "recordClassifications": {
    "object": {
      "description": "可独立引用的 Archive Object；有稳定 ID，可成为 ArchiveRef 与 Connection 成员。"
    },
    "component": {
      "description": "从属于父记录的纯结构件；可有自己的 SQLite 表、内部 ID 与父 ID，但不能成为 ArchiveRef 或 Connection 成员。"
    },
    "data": {
      "description": "测量、采样、日汇总或派生数据；可独立持久化，却没有可连接的档案对象身份。"
    }
  },
  "records": {
    "archive/connection": {
      "domain": "archive",
      "type": "connection",
      "classification": "object",
      "status": "partial",
      "description": "可含 0..N 个成员的连接组；可以嵌套，但不得形成环。",
      "fields": {
        "title": { "dataType": "string", "required": true },
        "description": { "dataType": "string", "required": false },
        "hasDetail": { "dataType": "integerEnum", "values": [0, 1], "required": true, "default": 0, "description": "对象专属 MD 位于 {archiveRoot}/details/{id}.md。" }
      },
      "childRecords": ["archive/connection-member"],
      "constraints": ["允许 0 个成员。", "Connection 可作为成员嵌套；禁止自引用与任意间接环。", "成员 Object 软删后保留 Member 引用，读取时显示为已删除。"],
      "open": [
        "连接关系 kind、证据、来源、状态等字段是否需要及其精确定义"
      ]
    },
    "journal/entry": {
      "domain": "journal",
      "type": "entry",
      "classification": "object",
      "status": "agreed",
      "fields": {
        "kind": {
          "dataType": "enum",
          "values": ["note", "document"],
          "required": true
        },
        "startedAt": {
          "dataType": "utcDateTime",
          "required": true
        },
        "endedAt": {
          "dataType": "utcDateTime",
          "required": false
        },
        "mood": {
          "dataType": "string",
          "required": false
        },
        "text": {
          "dataType": "string",
          "required": false,
          "description": "Note 的少量文字。"
        },
        "summary": {
          "dataType": "string",
          "required": false,
          "description": "Document 的可选摘要。"
        },
        "hasDetail": {
          "dataType": "integerEnum",
          "values": [0, 1],
          "required": true,
          "default": 0,
          "description": "对象专属 MD 详细内容的存在标志。MD 固定路径为 {archiveRoot}/details/{id}.md。"
        }
      },
      "variantField": "kind",
      "variants": {
        "note": {
          "requiredFields": ["text"],
          "enabledFields": ["startedAt", "endedAt", "mood", "text"],
          "fixedValues": { "hasDetail": 0 }
        },
        "document": {
          "enabledFields": ["startedAt", "endedAt", "mood", "summary", "hasDetail"],
          "fixedValues": { "hasDetail": 1 }
        }
      }
    },
    "health/meal": {
      "domain": "health",
      "type": "meal",
      "classification": "object",
      "status": "agreed",
      "fields": {
        "startedAt": { "dataType": "utcDateTime", "required": true },
        "endedAt": { "dataType": "utcDateTime", "required": false },
        "slot": {
          "dataType": "enum",
          "values": ["breakfast", "lunch", "dinner", "other"],
          "required": false
        },
        "text": { "dataType": "string", "required": false },
        "kcal": { "dataType": "number", "unit": "kcal", "required": false },
        "carbsGrams": { "dataType": "number", "unit": "g", "required": false },
        "proteinGrams": { "dataType": "number", "unit": "g", "required": false },
        "fatGrams": { "dataType": "number", "unit": "g", "required": false },
        "source": {
          "dataType": "string",
          "required": true,
          "description": "当前来源至少含 manual；具体可用来源由 Health adapter 维护。"
        }
      },
      "open": ["是否支持对象专属 MD 详细内容"]
    },
    "health/nap": {
      "domain": "health",
      "type": "nap",
      "classification": "object",
      "status": "agreed",
      "fields": {
        "startedAt": { "dataType": "utcDateTime", "required": true },
        "endedAt": { "dataType": "utcDateTime", "required": true },
        "text": { "dataType": "string", "required": false },
        "source": { "dataType": "string", "required": true }
      },
      "derivedFields": {
        "duration": {
          "dataType": "duration",
          "derivedFrom": ["startedAt", "endedAt"],
          "stored": false
        }
      }
    },
    "health/activity": {
      "domain": "health",
      "type": "activity",
      "classification": "object",
      "status": "agreed",
      "fields": {
        "startedAt": { "dataType": "utcDateTime", "required": true },
        "endedAt": { "dataType": "utcDateTime", "required": true },
        "type": {
          "dataType": "string",
          "required": true,
          "description": "Garmin 导入时原样使用 activityType.typeKey；手动创建从常用类型中选取或填 other。"
        },
        "title": { "dataType": "string", "required": false },
        "text": { "dataType": "string", "required": false },
        "distanceMeters": { "dataType": "number", "unit": "m", "required": false },
        "elevationGainMeters": { "dataType": "number", "unit": "m", "required": false },
        "avgHeartRateBpm": { "dataType": "number", "unit": "bpm", "required": false },
        "maxHeartRateBpm": { "dataType": "number", "unit": "bpm", "required": false },
        "avgSpeedMps": { "dataType": "number", "unit": "m/s", "required": false },
        "avgPaceSecondsPerKm": { "dataType": "number", "unit": "s/km", "required": false },
        "avgPowerWatts": { "dataType": "number", "unit": "W", "required": false },
        "source": { "dataType": "string", "required": true }
      },
      "variantField": "type",
      "variantRule": "type 不改变 SQLite 可存字段；它只选择默认的可读、可写、显示字段。未列出的 Garmin typeKey 使用 fallback，并保留已有值。",
      "variants": {
        "cycling": {
          "enabledFields": ["distanceMeters", "elevationGainMeters", "avgHeartRateBpm", "maxHeartRateBpm", "avgSpeedMps", "avgPowerWatts"]
        },
        "running": {
          "enabledFields": ["distanceMeters", "elevationGainMeters", "avgHeartRateBpm", "maxHeartRateBpm", "avgPaceSecondsPerKm"]
        },
        "walking": {
          "enabledFields": ["distanceMeters", "elevationGainMeters", "avgHeartRateBpm", "maxHeartRateBpm", "avgPaceSecondsPerKm"]
        },
        "hiking": {
          "enabledFields": ["distanceMeters", "elevationGainMeters", "avgHeartRateBpm", "maxHeartRateBpm", "avgPaceSecondsPerKm"]
        },
        "mountaineering": {
          "enabledFields": ["distanceMeters", "elevationGainMeters", "avgHeartRateBpm", "maxHeartRateBpm", "avgPaceSecondsPerKm"]
        },
        "strength_training": {
          "enabledFields": ["avgHeartRateBpm", "maxHeartRateBpm"]
        },
        "other": {
          "enabledFields": ["distanceMeters", "elevationGainMeters", "avgHeartRateBpm", "maxHeartRateBpm"]
        }
      },
      "fallback": {
        "enabledFields": ["distanceMeters", "elevationGainMeters", "avgHeartRateBpm", "maxHeartRateBpm", "avgSpeedMps", "avgPaceSecondsPerKm", "avgPowerWatts"]
      },
      "adapterDetailBoundary": "Garmin activity ID、原始 payload、路线、逐采样点指标、分段、训练组、文件下载等属于 Garmin adapter/detail，不是 Activity 的通用 Object 字段。"
    },
    "health/sleep-night": {
      "domain": "health",
      "type": "sleep-night",
      "classification": "object",
      "status": "agreed",
      "fields": {
        "startedAt": { "dataType": "utcDateTime", "required": true },
        "endedAt": { "dataType": "utcDateTime", "required": true },
        "text": { "dataType": "string", "required": false },
        "source": { "dataType": "string", "required": true },
        "sleepScore": { "dataType": "number", "required": false },
        "avgHeartRateBpm": { "dataType": "number", "unit": "bpm", "required": false },
        "avgHrvMs": { "dataType": "number", "unit": "ms", "required": false },
        "avgSpO2Percent": { "dataType": "number", "unit": "%", "required": false },
        "avgRespirationBpm": { "dataType": "number", "unit": "breaths/min", "required": false }
      },
      "childRecords": ["health/sleep-stage-segment"],
      "derivedFields": {
        "duration": { "dataType": "duration", "derivedFrom": ["startedAt", "endedAt"], "stored": false },
        "stageTotals": { "dataType": "stageDurationMap", "derivedFrom": ["stageSegments"], "stored": false },
        "wakeDate": { "dataType": "localDate", "derivedFrom": ["endedAt", "globalBusinessTimezone"], "stored": false }
      }
    },
    "health/day": {
      "domain": "health",
      "type": "day",
      "table": "health_days",
      "classification": "data",
      "status": "agreed",
      "description": "一日一条的 Health 汇总数据。体重/体成分和喝水不单开记录表，而是该日的可选字段。",
      "childRecords": ["health/sample"],
      "fields": {
        "localDate": { "dataType": "localDate", "required": true },
        "restingHeartRateBpm": { "dataType": "number", "unit": "bpm", "required": false },
        "minHeartRateBpm": { "dataType": "number", "unit": "bpm", "required": false },
        "maxHeartRateBpm": { "dataType": "number", "unit": "bpm", "required": false },
        "avgHeartRateBpm": { "dataType": "number", "unit": "bpm", "required": false },
        "avgSpO2Percent": { "dataType": "number", "unit": "%", "required": false },
        "minSpO2Percent": { "dataType": "number", "unit": "%", "required": false },
        "avgStress": { "dataType": "number", "required": false },
        "maxStress": { "dataType": "number", "required": false },
        "bodyBatteryHigh": { "dataType": "number", "required": false },
        "bodyBatteryLow": { "dataType": "number", "required": false },
        "bodyBatteryCharged": { "dataType": "number", "required": false },
        "bodyBatteryDrained": { "dataType": "number", "required": false },
        "avgRespirationBpm": { "dataType": "number", "unit": "breaths/min", "required": false },
        "minRespirationBpm": { "dataType": "number", "unit": "breaths/min", "required": false },
        "maxRespirationBpm": { "dataType": "number", "unit": "breaths/min", "required": false },
        "totalSteps": { "dataType": "integer", "required": false },
        "totalDistanceMeters": { "dataType": "number", "unit": "m", "required": false },
        "totalCaloriesKcal": { "dataType": "number", "unit": "kcal", "required": false },
        "activeCaloriesKcal": { "dataType": "number", "unit": "kcal", "required": false },
        "bmrCaloriesKcal": { "dataType": "number", "unit": "kcal", "required": false },
        "hydrationMl": { "dataType": "number", "unit": "ml", "required": false },
        "weightKg": { "dataType": "number", "unit": "kg", "required": false },
        "bodyFatPercent": { "dataType": "number", "unit": "%", "required": false }
      },
      "garminRefreshPolicy": {
        "status": "agreedForInitialVersion",
        "unit": "one localDate snapshot",
        "unchangedSnapshot": "内容 hash 相同则不写入。",
        "changedSnapshot": "在同一 SQLite transaction 中更新该日 Garmin 字段，删除该日的 Garmin Health Sample 行，再写入完整新采样集。",
        "manualBoundary": "首版不把手填值与 Garmin 值静默合并；若以后允许手填日指标，必须另定显式 override/优先级规则。"
      }
    },
    "health/sample": {
      "domain": "health",
      "type": "sample",
      "table": "health_samples",
      "classification": "data",
      "parent": { "record": "health/day", "foreignKey": "healthDayId" },
      "status": "agreed",
      "description": "所有日期的高频时序采样共用此长表；metric 与 series 说明值的语义与采样来源。",
      "fields": {
        "healthDayId": { "dataType": "uuid", "required": true },
        "metric": { "dataType": "enum", "values": ["heartRate", "spo2", "stress", "bodyBattery", "respiration", "steps"], "required": true },
        "series": { "dataType": "enum", "values": ["default", "daytime", "sleep"], "required": true, "default": "default" },
        "at": { "dataType": "utcDateTime", "required": true },
        "value": { "dataType": "number", "required": true }
      },
      "metricNotes": {
        "heartRate": "value 的单位为 bpm。",
        "spo2": "value 的单位为百分比；series 区分 daytime 与 sleep。",
        "stress": "value 为 0–100。",
        "bodyBattery": "value 为 0–100。",
        "respiration": "value 的单位为 breaths/min。",
        "steps": "value 为累计步数。"
      }
    },
    "work/project": {
      "domain": "work",
      "type": "project",
      "classification": "object",
      "status": "partial",
      "fields": {
        "title": { "dataType": "string", "required": true },
        "description": { "dataType": "string", "required": false },
        "status": { "dataType": "enum", "values": ["planning", "active", "archived"], "required": true }
      },
      "open": ["Project 归档、删除与恢复操作的完整规则见 ADR，不在本字段定义内。"]
    },
    "work/node": {
      "domain": "work",
      "type": "node",
      "classification": "object",
      "status": "partial",
      "fields": {
        "projectId": { "dataType": "uuid", "required": true },
        "parentNodeId": { "dataType": "uuid", "required": false },
        "kind": { "dataType": "enum", "values": ["task", "phase"], "required": true },
        "title": { "dataType": "string", "required": true },
        "order": { "dataType": "sortKey", "required": true }
      },
      "variantField": "kind",
      "variants": {
        "task": {
          "fields": {
            "status": { "dataType": "enum", "values": ["todo", "active", "done", "parked", "cancelled"], "required": true },
            "origin": { "dataType": "enum", "values": ["planned", "emergent", "promoted"], "required": true },
            "completedAt": { "dataType": "utcDateTime", "required": false }
          }
        },
        "phase": {
          "fields": {
            "status": { "dataType": "enum", "values": ["planning", "active", "done", "cancelled"], "required": true },
            "plannedStartAt": { "dataType": "utcDateTime", "required": false },
            "plannedEndAt": { "dataType": "utcDateTime", "required": false }
          },
          "constraints": ["不使用 parked。完成必须由用户手动触发，并检查全部后代。"]
        }
      }
    },
    "work/session": {
      "domain": "work",
      "type": "session",
      "classification": "object",
      "status": "partial",
      "fields": {
        "plannedStartAt": { "dataType": "utcDateTime", "required": false },
        "plannedEndAt": { "dataType": "utcDateTime", "required": false },
        "startedAt": { "dataType": "utcDateTime", "required": false },
        "endedAt": { "dataType": "utcDateTime", "required": false },
        "summary": { "dataType": "string", "required": false }
      },
      "constraints": ["Session 可跨 Project。开始时至少须有一个 Segment；最终结束的 Session 必有 startedAt 与 endedAt。"]
    },
    "work/segment": {
      "domain": "work",
      "type": "segment",
      "classification": "object",
      "status": "partial",
      "fields": {
        "sessionId": { "dataType": "uuid", "required": true },
        "projectId": { "dataType": "uuid", "required": true },
        "nodeId": { "dataType": "uuid", "required": false, "description": "至多一个。" },
        "plannedStartAt": { "dataType": "utcDateTime", "required": false },
        "plannedEndAt": { "dataType": "utcDateTime", "required": false },
        "status": { "dataType": "enum", "values": ["planned", "active", "paused", "ended", "skipped"], "required": true },
        "summary": { "dataType": "string", "required": false }
      },
      "childRecords": ["work/interval"]
    },
    "plan/plan-item": {
      "domain": "plan",
      "type": "plan-item",
      "classification": "object",
      "status": "partial",
      "fields": {
        "kind": { "dataType": "enum", "values": ["todo", "schedule"], "required": true },
        "title": { "dataType": "string", "required": true },
        "description": { "dataType": "string", "required": false },
        "hasDetail": { "dataType": "integerEnum", "values": [0, 1], "required": true, "default": 0 },
        "status": { "dataType": "enum", "values": ["todo", "done", "cancelled"], "required": true },
        "completedAt": { "dataType": "utcDateTime", "required": false, "managedBy": "system" },
        "groupId": { "dataType": "uuid", "required": false },
        "recurrenceId": { "dataType": "uuid", "required": false }
      },
      "variantField": "kind",
      "variants": {
        "todo": {
          "fields": {
            "plannedTime": { "dataType": "localDateOrUtcDateTime", "required": false }
          }
        },
        "schedule": {
          "fields": {
            "startAt": { "dataType": "utcDateTime", "required": true },
            "endAt": { "dataType": "utcDateTime", "required": true }
          },
          "childRecords": ["plan/schedule-block"]
        }
      }
    },
    "plan/schedule-block": {
      "classification": "component",
      "parent": "plan/plan-item#schedule",
      "status": "agreed",
      "fields": {
        "id": { "dataType": "uuid", "required": true },
        "scheduleId": { "dataType": "uuid", "required": true },
        "side": { "dataType": "enum", "values": ["before", "after"], "required": true },
        "order": { "dataType": "sortKey", "required": true },
        "durationMinutes": { "dataType": "integer", "required": true, "minimum": 0 },
        "name": { "dataType": "string", "required": true },
        "description": { "dataType": "string", "required": true },
        "hasDetail": { "dataType": "integerEnum", "values": [0, 1], "required": true, "default": 0 }
      },
      "constraints": ["每侧最多三条。它们与 Schedule 主时段及相邻 Block 严格首尾相接。"]
    },
    "archive/connection-member": {
      "classification": "component",
      "parent": { "record": "archive/connection", "foreignKey": "connectionId" },
      "status": "partial",
      "fields": {
        "id": { "dataType": "uuid", "required": true },
        "connectionId": { "dataType": "uuid", "required": true },
        "memberDomain": { "dataType": "string", "required": true },
        "memberType": { "dataType": "string", "required": true },
        "memberId": { "dataType": "uuid", "required": true },
        "kind": { "dataType": "string", "required": false, "description": "首版不赋予行为；关系语义成熟后再收紧。" }
      },
      "constraints": ["唯一键为 (connectionId, memberDomain, memberType, memberId)。"]
    },
    "health/sleep-stage-segment": {
      "classification": "data",
      "parent": { "record": "health/sleep-night", "foreignKey": "sleepNightId" },
      "status": "agreed",
      "fields": {
        "id": { "dataType": "uuid", "required": true },
        "sleepNightId": { "dataType": "uuid", "required": true },
        "startedAt": { "dataType": "utcDateTime", "required": true },
        "endedAt": { "dataType": "utcDateTime", "required": true },
        "stage": { "dataType": "enum", "values": ["awake", "light", "deep", "rem"], "required": true }
      },
      "constraints": ["所有分段在父 SleepNight 起止范围内，彼此不得重叠，但可以有数据缺失空洞。"]
    },
    "work/interval": {
      "classification": "component",
      "parent": { "record": "work/segment", "foreignKey": "segmentId" },
      "status": "agreed",
      "fields": {
        "id": { "dataType": "uuid", "required": true },
        "segmentId": { "dataType": "uuid", "required": true },
        "startedAt": { "dataType": "utcDateTime", "required": true },
        "endedAt": { "dataType": "utcDateTime", "required": true }
      }
    },
    "plan/group": {
      "classification": "data",
      "description": "Plan 的组织元数据，可由 parentGroupId 形成文件夹树。"
    },
    "finance/transaction": {
      "domain": "finance",
      "type": "transaction",
      "table": "finance_transactions",
      "classification": "object",
      "status": "reserved",
      "description": "Finance v2 的唯一可同步事实根。其精确会计字段、金额表达、删除/恢复与领域 validator 仍待独立设计；SQLite 是目标真源，PC `.bean` 是其受控派生输出。",
      "childRecords": ["finance/posting"],
      "fields": {},
      "constraints": [
        "Transaction 与其 Posting 必须作为同一 Sync Core aggregate 原子验证和传输。",
        "Observation、对账工作数据、账户映射和 `.bean` materialization 不是此 Object 或其同步 payload。"
      ],
      "open": [
        "Transaction / Posting 的精确 SQLite 字段、金额与 commodity 表达、会计不变量、引用和 tombstone 规则。"
      ]
    },
    "finance/posting": {
      "domain": "finance",
      "type": "posting",
      "table": "finance_postings",
      "classification": "component",
      "parent": { "record": "finance/transaction", "foreignKey": "transactionId" },
      "status": "reserved",
      "description": "从属于 Finance Transaction 的会计组件；有 SQLite 身份和审计需要，但不可形成 ArchiveRef 或 Connection Member。",
      "fields": {},
      "open": [
        "Posting 的账户、金额、commodity、cost、price、metadata 与排序/平衡约束。"
      ]
    }
  }
}
