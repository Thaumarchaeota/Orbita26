[Unit]
Description=Orbita Sync SQLite Online Backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=orbita
Group=orbita
WorkingDirectory=/srv/app/orbita-sync
ExecStart=/usr/bin/docker compose -f /srv/app/orbita-sync/deploy/docker-compose.yml --profile backup run --rm --no-deps orbita-sync-backup
